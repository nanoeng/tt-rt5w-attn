# PSY-TaLiRo falsification on the RTL (test_falsify.py).
#   make -f Makefile.falsify                       # Icarus
#   make -f Makefile.falsify SIM=verilator         # Verilator
#   make -f Makefile.falsify FALSIFY_BUDGET=60     # more samples per test
export FALSIFY_BUDGET ?= 24
export FALSIFY_SEED ?= 1
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(CURDIR)/../src
VERILOG_SOURCES = $(SRC_DIR)/project.v $(SRC_DIR)/rt5w_digital.v $(SRC_DIR)/rt5w_ctrl.v $(CURDIR)/rt5w_analog_beh.v $(CURDIR)/tb.v
SIM_BUILD = sim_build/falsify_$(SIM)
TOPLEVEL = tb
COCOTB_TEST_MODULES = test_falsify
ifeq ($(SIM),icarus)
COMPILE_ARGS += -g2012
endif
ifeq ($(SIM),verilator)
EXTRA_ARGS += --timing -Wno-fatal -Wno-lint -Wno-style -Wno-REALCVT -Wno-MULTIDRIVEN
ifeq ($(WAVES),1)
EXTRA_ARGS += --trace-fst --trace-structs
SIM_ARGS += --trace --trace-file $(CURDIR)/../waves/falsify_verilator.fst
endif
endif
include $(shell cocotb-config --makefiles)/Makefile.sim
